// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) // Unique identifier for the user
  name        String? // Nullable field for user's name
  email       String   @unique // Email must be unique for each user
  password    String? // Nullable field for password (only for email signup)
  dateCreated DateTime @default(now()) // Timestamp for when the user is created
  dateUpdated DateTime @updatedAt // Automatically updated on record updates
}
