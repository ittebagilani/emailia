// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(cuid())
  clerkId     String         @unique // Clerk's unique user ID
  email       String         @unique
  name        String?
  lists       List[]         // One-to-many relationship with List
  verifiedEmails VerifiedEmail[] // One-to-many relationship with VerifiedEmail
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model List {
  id          String      @id @default(cuid())
  name        String
  userId      String      // Foreign key to your user table
  user        User        @relation(fields: [userId], references: [id])
  businesses  Business[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Business {
  id          String    @id @default(cuid())
  listId      String
  list        List      @relation(fields: [listId], references: [id])
  placeId     String
  name        String
  address     String?
  phone       String?
  website     String?
  email       String?
  rating      Float?
  priceLevel  Int?
  latitude    Float?
  longitude   Float?
}

model VerifiedEmail {
  id        String   @id @default(cuid())
  userId    String   // Foreign key to the User model
  email     String   @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}
